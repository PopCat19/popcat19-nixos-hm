# .gitignore
#
# Purpose: Exclude build artifacts and editor files from version control
#
# This module:
# - Ignores Nix build results and artifacts
# - Excludes editor and IDE configuration
# - Filters backup and temporary files

# Build results
result
result-*
.direnv/

# Editor files
.idea/
.kilocode/
.opencode/
.roo/
.vscode/
*.swo
*.swp

# Backup files
*.bak
*.bak[0-9]
*.backup
*~
configuration.nix.bak*

# Temporary files
.DS_Store
Thumbs.db

# Large directories
node_modules
