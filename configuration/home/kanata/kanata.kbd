;; ijkl mouse-emulation layer.
;;
;; Entry: Super+C (chord). Tapping C alone still types a c.
;; Exit:  plain c or Esc from the mouse layer (ergonomic: same finger
;;         as movement). Super+C from mouse mode falls through and
;;         re-enters; noise but functional.
;; Each transition fires a desktop notification listing the active
;; keybinds as a reminder.
;; Mouse layer keys:
;;   i / j / k / l  - cursor movement (accelerates while held)
;;   spc            - left click (hold to drag)
;;   h              - right click
;;   s              - middle click
;;   m / n          - mouse back / forward
;;   u / o          - scroll down / up
;;   z              - focus (precision movement; press/hold)
;;   [ ]            - home / end
;;   , .            - page up / page down
;;   - =            - volume down / up
;;   0              - mute toggle
;;   7 8 9          - media prev / play-pause / next
;;   ; ' /          - alt / ctrl / shift (held; for click combos)
;;
;; Force exit: hold left Ctrl + Space + Escape.

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  ;; movemouse-inherit-accel-state yes: qmk-like, new directions jump to max
  ;;   speed instantly. Feels like adding a direction doubles speed.
  ;; movemouse-inherit-accel-state no : new directions ramp from min, so
  ;;   diagonals grow gradually over accelTime. Smoother feel.
  movemouse-inherit-accel-state no
  movemouse-smooth-diagonals yes
  linux-continue-if-no-devs-found yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc nlck
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    esc
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; Mouse movement: zero-range acceleration for constant speed
;; with live speed scaling.
;; movemouse-accel with min=max=10 and accelTime=1 ms yields
;; constant 10 px/tick (1250 px/s at 125 Hz). The 1 ms accelTime
;; means the "ramp" completes instantly, producing no perceptible
;; acceleration while keeping the action compatible with
;; movemouse-speed.
;; z is bound to (movemouse-speed 30), which multiplies active
;; movemouse-accel actions to 30% (3 px/tick). Because it targets
;; the underlying movemouse-accel state, holding z slows movement
;; even if i/j/k/l were already held. The 30% multiplier persists
;; after releasing z until the mouse layer exits.
;; Scroll: mwheel-accel with exponential ramp, used as default:
;; initial 10 -> max 800, acceleration_multiplier 1.04 (each tick
;; multiplies velocity by 1.04 -> gentle exponential; takes ~88 ticks
;; to hit the 800 cap vs ~22 ticks at 1.12). Slow start (10) covers
;; precision scrolling; long gentle ramp to fast (800) for pages.
;; deceleration 0.6. No dedicated boost key needed.
(defalias
  mmu      (movemouse-accel-up    8 1 10 10)
  mmd      (movemouse-accel-down  8 1 10 10)
  mml      (movemouse-accel-left  8 1 10 10)
  mmr      (movemouse-accel-right 8 1 10 10)
  mwu      (mwheel-accel-up   10.0 800.0 1.04 0.6)
  mwd      (mwheel-accel-down 10.0 800.0 1.04 0.6)
)

;; Super+C: hold to activate mouse layer (no toggle).
;; fork with lmet as trigger so plain C still types c.
;; (layer-while-held mouse) activates mouse mode only while c is held;
;; release of c exits automatically.
;; (release-key lmet) synthetically releases Super to the OS on entry so
;;   Hyprland does not see Super held during mouse mode (avoids Super
;;   overlay / Super+key conflicts). kanata still tracks the physical
;;   lmet hold for the fork trigger; the layer-while-held is tied to the
;;   c key hold, so releasing the lmet output does not end the layer.
;;   Trade-off: Hyprland sees a brief Super down->up (phantom tap) on
;;   entry; same already happens on exit today. No delay on plain Super
;;   for normal Hyprland binds (unlike a defchordsv2 approach).
;; (cmd notify-send) fires the ON notification on activation.
(defalias
  tog-c (fork c
              (multi
                (layer-while-held mouse)
                (release-key lmet)
                (cmd notify-send "Kanata: mouse ON" "i/j/k/l move  spc L-click  h R-click  s M-click  n/m back/fwd  u scroll-down  o scroll-up  z focus 30%  [ ] end/home  , . pgdn/pgup  - = vol dn/up  0 mute  7 8 9 media prev/play/next  ; ' / lalt/lctl/lsft  hold Super+C" -t 3000 -u normal))
              (lmet))

  ;; Super+B: switch to mouse-pass (persists until explicit exit).
  ;; Uses layer-switch (not layer-toggle) so the layer change is
  ;; unconditional and not tied to the b key's hold/release lifecycle.
  ;; plain B still types b.
  tog-b (fork b
              (multi
                (layer-switch mouse-pass)
                (cmd notify-send "Kanata: mouse passthrough ON" "i/j/k/l move  spc L-click/drag  h R-click  s M-click  u/o scroll  z focus 30%  Ctrl/Shift/Alt/Super pass through  b or Esc exits" -t 3000 -u normal))
              (lmet))
)

;; Default layer uses deflayermap (input->action pairs) instead of
;; positional deflayer columns. Only the c and b positions are
;; overridden; all other keys implicitly use their defsrc value (the
;; literal key). c is bound to @tog-c so plain C still types c, but
;; Super+C holds the mouse layer (and masks Super via release-key)
;; while both held. b is bound to @tog-b so plain B still types b,
;; but Super+B switches into mouse-pass until b or Esc switches back.
;; nlck XX swallows the physical NumLock so it cannot fight Hyprland's
;; numlock_by_default = true (which sets the software state on connect).
(deflayermap (default)
  c    @tog-c
  b    @tog-b
  nlck XX
)

;; Mouse layer: right-handable while Super+C is held (left hand).
;;   i j k l  - movement (right hand home row)
;;   spc      - mlft (hold to drag) -- left thumb
;;   h        - mrgt (right click)
;;   s        - mmid (middle click)
;;   n m      - mouse back / forward
;;   u o      - scroll down / up (exponential mwheel-accel, see defalias)
;;   z        - movemouse-speed 30% (slows active movement to 3 px/tick)
;;   [ ]      - home / end
;;   , .      - pgup / pgdn
;;   - =      - volume down / up
;;   0        - mute toggle
;;   7 8 9    - media prev / play-pause / next
;;   ; ' /    - hold lalt / lctl / lsft (right-hand mod for click combos)
;;
;; Release of Super+C exits mouse mode automatically (layer-while-held).
;;
;; Why no scroll-boost key: mwheel-accel's slow-start ramp (initial=10)
;; already covers precision scrolling, and ramps to fast (max=800) for
;; long pages. A separate boost key would add complexity for no gain.
;;
;; ___ XX: wildcard mapping every unmapped key to no-op. Nothing
;; else leaks to Hyprland during mouse mode (prevents phantom
;; Super+key or plain-key multi-actions). The explicitly mapped keys
;; above still work. Already-held keys (c, lmet) are unaffected —
;; layer change does not re-trigger held keys, and their release is
;; driven by the press-time action (layer-while-held / lmet output).
;; Force-exit (lctl+spc+esc) still works: it is handled before any
;; layer/kanata remapping.
(deflayermap (mouse)
  i    @mmu
  j    @mml
  k    @mmd
  l    @mmr
  spc  mlft
  h    mrgt
  s    mmid
  n    mbck
  m    mfwd
  u    @mwd
  o    @mwu
  z    (movemouse-speed 30)
  [    end
  ]    home
  ,    pgdn
  .    pgup
  -    vold
  =    volu
  0    mute
  7    prev
  8    pp
  9    next

  ;; Right-hand modifier passthrough. Without these, ; ' / would be
  ;; swallowed by ___ XX. Plain key -> modifier is already momentary
  ;; in Kanata: press-down -> modifier-down, release -> modifier-up,
  ;; no action wrapper needed. Lets you hold ' + spc for Ctrl+click
  ;; or ; + i/j/k/l for Alt+arrow-style bindings without leaving the
  ;; mouse layer. mouse-pass already passes the physical modifiers
  ;; through, so this is only needed here.
  ;    lalt
  '    lctl
  /    lsft

  ___  XX
)

;; Toggled mouse layer with modifier passthrough.
;;
;; Entry: Super+B (via @tog-b, layer-switch)
;; Exit:  b or Esc (both switch back to default directly)
;;
;; Unlike the Super+C held layer above, this layer lets modifier keys
;; pass through to Hyprland/apps:
;;   Shift+click / Ctrl+click -> GUI multi-select works.
;;   Super+spc -> Super+left-click, so Hyprland bindm can move windows.
;;   Super+right-click -> Super+right-click for resize if bound.
;;   Plain Alt alone (or Ctrl/Shift/Super) also passes through, so you
;;   can hold a modifier for an app-specific binding while staying in
;;   mouse-pass. The key -> key mapping is independent of the layer's
;;   own activation state.
;;
;; Non-mapped normal keys are still swallowed by ___ XX so random
;; letters do not leak while using mouse mode. The release-key in
;; tog-c was dropped here on purpose (see tog-b comment).
;;
;; Note: this only uses lmet as the fork trigger. rmet (right Super)
;; is not bound; if needed, add a parallel fork with (rmet) as the
;; second trigger (kanata fork triggers are OR'd when listed).
(deflayermap (mouse-pass)
  i    @mmu
  j    @mml
  k    @mmd
  l    @mmr

  spc  mlft
  h    mrgt
  s    mmid

  n    mbck
  m    mfwd

  u    @mwd
  o    @mwu

  z    (movemouse-speed 30)

  ;; Let modifiers pass through to Hyprland/apps.
  lctl lctl
  rctl rctl
  lsft lsft
  rsft rsft
  lalt lalt
  ralt ralt
  lmet lmet
  rmet rmet

  ;; Exit passthrough mouse mode. Direct layer-switch (not toggle) so
  ;; the action is unconditional on entry state and independent of any
  ;; fork hold semantics. The notify-send fires the OFF notification
  ;; in the same multi.
  b    (multi (layer-switch default) (cmd notify-send "Kanata: mouse passthrough OFF" "" -t 3000 -u low))
  esc  (multi (layer-switch default) (cmd notify-send "Kanata: mouse passthrough OFF" "" -t 3000 -u low))

  ;; Transparent fallback: any unmapped key outputs its defsrc value,
  ;; so q w e r t y a d f g etc. type normally while in mouse-pass.
  ;; Makes the layer usable for browser workflows: move the mouse
  ;; with ijkl AND keep typing in the address bar / search box /
  ;; quick-find without leaving the layer.
  ;;
  ;; ___ is the input wildcard ("all unmapped keys in this layer"),
  ;; use-defsrc is the action ("output the corresponding defsrc key").
  ;; These are distinct concepts; ___ XX would mean "block all
  ;; unmapped keys" (the previous behavior). The mouse layer keeps
  ;; ___ XX so it stays fully isolated -- different design intent
  ;; (no leaks during quick mouse-mode flashes).
  ___  use-defsrc
)
