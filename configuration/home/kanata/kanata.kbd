;; hjkl mouse-emulation layers.
;;
;; Two entry points, two layers:
;;   Super+C held -> mouse-c: hjkl mouse + F-key nav/media/brightness
;;                  macros (see mouse-c). Release C exits.
;;   Rshift tap   -> mouse-pass: hjkl mouse + full typing passthrough
;;                  (use-defsrc). Rshift tap or b exits.
;; Plain C still types c; Rshift held >=120ms still acts as Shift.
;; Each transition fires a short on/off desktop notification.
;;
;; Common mouse keys (both layers):
;;   h / j / k / l  - cursor movement (movemouse-accel 2->8px)
;;   spc            - left click (hold to drag)
;;   ;              - middle click
;;   n              - right click
;;   , / .          - mouse back / forward
;;   i / o          - scroll down / up
;;
;; Shared F-key macros (both mouse-c and mouse-pass, via @f5..@f12):
;;   f5 / f6    - brightness down / up 10%
;;   f7 / f8    - tap pgdn/pgup, hold end/home
;;   f9 / f10   - tap play-pause/mute, double-tap prev/next
;;   f11 / f12  - volume down / up
;;
;; Force exit: hold left Ctrl + Space + Escape.

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  ;; movemouse-inherit-accel-state yes: qmk-like, new directions jump to max
  ;;   speed instantly. Feels like adding a direction doubles speed.
  ;; movemouse-inherit-accel-state no : new directions ramp from min, so
  ;;   diagonals grow gradually over accelTime. Smoother feel.
  movemouse-inherit-accel-state no
  movemouse-smooth-diagonals yes
  linux-continue-if-no-devs-found yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc nlck
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    esc
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; Mouse movement: linear acceleration (movemouse-accel).
;; hjkl starts at 2 px/tick and ramps to 8 px/tick over 300ms. A quick
;; tap moves slowly (precision); a held key reaches 8 px. Replaces the
;; old z focus/boost split -- no dedicated focus key needed.
;; Scroll: mwheel-accel with exponential ramp, used as default:
;; initial 10 -> max 800, acceleration_multiplier 1.04 (each tick
;; multiplies velocity by 1.04 -> gentle exponential; takes ~88 ticks
;; to hit the 800 cap vs ~22 ticks at 1.12). Slow start (10) covers
;; precision scrolling; long gentle ramp to fast (800) for pages.
;; deceleration 0.6. No dedicated boost key needed.
(defalias
  mmu      (movemouse-accel-up    8 300 2 8)
  mmd      (movemouse-accel-down  8 300 2 8)
  mml      (movemouse-accel-left  8 300 2 8)
  mmr      (movemouse-accel-right 8 300 2 8)
  mwu      (mwheel-accel-up   10.0 800.0 1.04 0.6)
  mwd      (mwheel-accel-down 10.0 800.0 1.04 0.6)

  ;; Shared function-key nav/media/brightness cluster, used by both
  ;; mouse-c and mouse-pass so the bindings live in one place.
  ;;   f5/f6  - brightness down/up 10%   (cmd brightnessctl)
  ;;   f7/f8  - tap pgdn/pgup, hold 200ms end/home
  ;;   f9/f10 - tap play-pause/mute, double-tap prev/next
  ;;   f11/f12- volume down/up
  f5   (cmd "brightnessctl s 10%-")
  f6   (cmd "brightnessctl s 10%+")
  f7   (tap-hold 100 200 pgdn end)
  f8   (tap-hold 100 200 pgup home)
  f9   (tap-dance 200 (pp prev))
  f10  (tap-dance 200 (mute next))
  f11  vold
  f12  volu
)

;; Super+C: hold to activate the dedicated mouse-c layer (no toggle).
;; fork with lmet as trigger so plain C still types c.
;; (layer-while-held mouse-c) activates mouse mode only while c is
;;   held; release of c exits automatically. mouse-c has the hjkl mouse
;;   actions plus function-key nav/media/brightness macros (see below).
;; (release-key lmet) synthetically releases Super to the OS on entry so
;;   Hyprland does not see Super held during mouse mode (avoids Super
;;   overlay / Super+key conflicts). kanata still tracks the physical
;;   lmet hold for the fork trigger; the layer-while-held is tied to the
;;   c key hold, so releasing the lmet output does not end the layer.
;;   Trade-off: Hyprland sees a brief Super down->up (phantom tap) on
;;   entry; same already happens on exit today. No delay on plain Super
;;   for normal Hyprland binds (unlike a defchordsv2 approach).
;;   Also means Super+spc (Hyprland window move) does not work while
;;   Super+C is held; use the Rshift-toggled mouse-pass for that.
;; (cmd notify-send) fires the ON notification on activation.
(defalias
  tog-c (fork c
              (multi
                (layer-while-held mouse-c)
                (release-key lmet)
                (cmd notify-send "Kanata: on" "" -t 500 -u normal))
              (lmet))

  ;; Rshift: tap (released within 120ms) toggles mouse-pass on
  ;; (semi-passthrough). Held >= 120ms it acts as plain Right Shift
  ;; (tap-hold). The exit direction is bound in mouse-pass (rsft there
  ;; is the same tap-hold, tap = back to default). Ralt passes through
  ;; normally again.
  tog-rsft (multi
             (layer-switch mouse-pass)
             (cmd notify-send "Kanata: on" "" -t 500 -u normal))
  exit-rsft (multi
             (layer-switch default)
             (cmd notify-send "Kanata: off" "" -t 500 -u low))
)

;; Default layer uses deflayermap (input->action pairs) instead of
;; positional deflayer columns. Only the c and rsft positions are
;; overridden; all other keys implicitly use their defsrc value (the
;; literal key). c is bound to @tog-c so plain C still types c, but
;; Super+C holds mouse-pass (and masks Super via release-key) while
;; both held. rsft is a tap-hold: tap (released within 120ms) toggles
;; mouse-pass on via @tog-rsft; held >= 120ms acts as Right Shift.
;; nlck XX swallows the physical NumLock so it cannot fight Hyprland's
;; numlock_by_default = true (which sets the software state on connect).
(deflayermap (default)
  c    @tog-c
  rsft (tap-hold 120 120 @tog-rsft rsft)
  caps (tap-hold 200 200 esc caps)
  nlck XX
)

;; Semi-passthrough mouse layer.
;;
;; Entry: Rshift tap (toggle, via @tog-rsft) or Super+C held (via @tog-c).
;; Exit:  Rshift tap, or b (both switch back to default directly).
;;
;; Modifier keys pass through to Hyprland/apps:
;;   Shift+click / Ctrl+click -> GUI multi-select works.
;;   Super+spc -> Super+left-click, so Hyprland bindm can move windows
;;     (only in the Rshift-toggled mode; Super+C held masks Super).
;;   Super+right-click -> Super+right-click for resize if bound.
;;   Plain Alt alone (or Ctrl/Shift/Super) also passes through, so you
;;   can hold a modifier for an app-specific binding while staying in
;;   mouse-pass. The key -> key mapping is independent of the layer's
;;   own activation state.
;;
;; Rshift is the entry/exit toggle via tap-hold (see @tog-rsft and the
;;   rsft binding below): tap = toggle mouse-pass, held >= 120ms =
;;   Right Shift pass-through. Ralt passes through normally.
;;
;; Unmapped normal keys output their defsrc value (use-defsrc below) so
;;   q w e r t y a d f g etc. type normally -- usable for browser
;;   workflows (move the mouse with hjkl AND keep typing).
;;
;; Note: tog-c (Super+C) uses lmet as the fork trigger. rmet (right
;;   Super) is not bound; if needed, add a parallel fork with (rmet)
;;   as the second trigger (kanata fork triggers are OR'd when listed).
(deflayermap (mouse-pass)
  caps (tap-hold 200 200 esc caps)
  k    @mmu
  h    @mml
  j    @mmd
  l    @mmr

  spc  mlft
  ;    mmid
  n    mrgt
  ,    mbck
  .    mfwd
  i    @mwd
  o    @mwu

  ;; Let modifiers pass through to Hyprland/apps. rsft is a tap-hold:
  ;; tap (released within 100ms) exits mouse-pass via @exit-rsft; held
  ;; >= 120ms acts as Right Shift.
  lctl lctl
  rctl rctl
  lsft lsft
  rsft (tap-hold 120 120 @exit-rsft rsft)
  lalt lalt
  ralt ralt
  lmet lmet
  rmet rmet

  ;; Exit passthrough mouse mode. Direct layer-switch (not toggle) so
  ;; the action is unconditional on entry state and independent of any
  ;; fork hold semantics. esc and b both pass through via ___ use-defsrc
  ;; below (use rsft-tap to leave mouse-pass).

  f5   @f5
  f6   @f6
  f7   @f7
  f8   @f8
  f9   @f9
  f10  @f10
  f11  @f11
  f12  @f12

  ;; Transparent fallback: any unmapped key outputs its defsrc value,
  ;; so q w e r t y a d f g etc. type normally while in mouse-pass.
  ;; Makes the layer usable for browser workflows: move the mouse
  ;; with hjkl AND keep typing in the address bar / search box /
  ;; quick-find without leaving the layer.
  ;;
  ;; ___ is the input wildcard ("all unmapped keys in this layer"),
  ;; use-defsrc is the action ("output the corresponding defsrc key").
  ;; These are distinct concepts; ___ XX would mean "block all
  ;; unmapped keys" (the previous behavior). The mouse layer keeps
  ;; ___ XX so it stays fully isolated -- different design intent
  ;; (no leaks during quick mouse-mode flashes).
  ___  use-defsrc
)

;; Super+C held layer: hjkl mouse + function-key nav/media/brightness
;; macros (@f5..@f12, shared with mouse-pass), with use-defsrc
;; semi-passthrough for everything else.
;;
;; Entry: Super+C held (via @tog-c, layer-while-held). Release C exits.
;;   Super is masked on entry (release-key lmet), so Super+spc window
;;   move does NOT work here -- use the Rshift-toggled mouse-pass.
;;
;; Mouse:
;;   h j k l  - movement (movemouse-accel: 2px -> 8px over 300ms)
;;   spc      - left click (hold to drag)
;;   ;        - middle click
;;   m        - right click
;;   , .      - mouse back / forward
;;   i o      - scroll down / up
;;
;; Everything else (letters, modifiers, etc.) outputs its defsrc value
;;   via ___ use-defsrc, so typing works while the layer is held. c is
;;   mapped XX so the held trigger key never repeats 'c'.
;;
;; Latency notes (--check is syntax-only, not runtime-verified):
;;   - f9/f10 single-tap (pp/mute) fires on the next keypress or after
;;     the 200ms tap-dance timeout; an isolated single tap waits up to
;;     200ms before firing.
;;   - f7/f8 hold (end/home) needs a 200ms hold; a quick tap gives
;;     pgdn/pgup.
(deflayermap (mouse-c)
  caps (tap-hold 200 200 esc caps)
  h    @mml
  j    @mmd
  k    @mmu
  l    @mmr
  spc  mlft
  ;    mmid
  n    mrgt
  ,    mbck
  .    mfwd
  i    @mwd
  o    @mwu

  f5   @f5
  f6   @f6
  f7   @f7
  f8   @f8
  f9   @f9
  f10  @f10
  f11  @f11
  f12  @f12

  c    XX

  ___  use-defsrc
)

;; Navigation layer.
;; Entry: Super+D held.
;; Exit:  release D (layer-while-held).
;; hjkl -> arrow keys, i -> S-tab, o -> tab, u -> enter.
;; Space types normally; all other unmapped keys are blocked (XX)
;; to prevent phantom Super+key combos while navigating.
(deflayermap (nav)
  caps (tap-hold 200 200 esc caps)
  h    left
  j    down
  k    up
  l    rght
  i    S-tab
  o    tab
  u    ret
  spc  spc

  ___  XX
)
